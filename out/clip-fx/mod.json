{
  "manifest_version": 2,
  "mod": {
    "id": "clip-fx",
    "name": "Clip: Clip FX",
    "version": "0.1.0-dev.45",
    "author": "Cimm",
    "description": "Effects for a single clip or audio event, like Studio One's Event FX: turn on Clip FX in the Inspector and add inserts that only that clip plays through. Work in progress.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "macos",
    "architecture": "universal"
  },
  "helper": {
    "jar": "helper.jar",
    "class": "com.cimm.clipfx.MixerHide"
  },
  "targets": {
    "com.bitwig.ramona.core.XKG.cfM": {
      "kind": "method",
      "owner": "com/bitwig/ramona/core/XKG",
      "name": "cfM",
      "descriptor": "(Z)Z"
    },
    "com.bitwig.flt.widget.core.device.htp.cfM": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/device/htp",
      "name": "cfM",
      "descriptor": "(Ljsd;)Lcom/bitwig/flt/widget/core/device/gRj;"
    },
    "com.bitwig.flt.widget.core.device.htp.MRY": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/device/htp",
      "name": "MRY",
      "descriptor": "(Ljsd;)Lcom/bitwig/flt/widget/core/device/gRj;"
    },
    "com.bitwig.flt.widget.core.device.uMi.MRY": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/device/uMi",
      "name": "MRY",
      "descriptor": "(Ljsd;)Lcom/bitwig/flt/widget/core/device/gRj;"
    },
    "com.bitwig.base.geom.SYo.Hnt": {
      "kind": "field",
      "owner": "com/bitwig/base/geom/SYo",
      "name": "Hnt",
      "descriptor": "J"
    },
    "SEJ.cfM": {
      "kind": "method",
      "owner": "SEJ",
      "name": "cfM",
      "descriptor": "(LOb;)Lla1;"
    },
    "com.bitwig.flt.document.core.master.device.zTz.wZs": {
      "kind": "method",
      "owner": "com/bitwig/flt/document/core/master/device/zTz",
      "name": "wZs",
      "descriptor": "()Lcom/bitwig/flt/document/core/master/device/ISf;"
    },
    "dve.iG_": {
      "kind": "method",
      "owner": "dve",
      "name": "iG_",
      "descriptor": "()Lcom/bitwig/base/geom/SYo;"
    },
    "dve.kJ_": {
      "kind": "method",
      "owner": "dve",
      "name": "kJ_",
      "descriptor": "()V"
    },
    "xJo.DxJ": {
      "kind": "method",
      "owner": "xJo",
      "name": "DxJ",
      "descriptor": "()Lcom/bitwig/flt/document/core/master/device/FUR;"
    },
    "xJo.mcL": {
      "kind": "method",
      "owner": "xJo",
      "name": "mcL",
      "descriptor": "()Lcom/bitwig/flt/document/core/master/device/xlG;"
    },
    "xJo.meo": {
      "kind": "method",
      "owner": "xJo",
      "name": "meo",
      "descriptor": "()LLEn;"
    },
    "xJo.sWR": {
      "kind": "method",
      "owner": "xJo",
      "name": "sWR",
      "descriptor": "()Lcom/bitwig/flt/document/core/master/device/ISf;"
    },
    "yBZ.lYc": {
      "kind": "method",
      "owner": "yBZ",
      "name": "lYc",
      "descriptor": "(Z)V"
    }
  },
  "hooks": [
    {
      "id": "store-in-step",
      "target": "com.bitwig.ramona.core.XKG.cfM",
      "transform": "INSERT_AT_ENTRY",
      "bridge": {
        "method": "inStep",
        "descriptor": "()V",
        "args": []
      }
    },
    {
      "id": "hide-unit-in-chain",
      "target": "com.bitwig.flt.widget.core.device.htp.cfM",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "chainRow",
        "descriptor": "(Lcom/bitwig/flt/widget/core/device/gRj;Lcom/bitwig/flt/widget/core/device/htp;Ljsd;)Lcom/bitwig/flt/widget/core/device/gRj;",
        "args": [
          "this",
          "arg1"
        ]
      }
    },
    {
      "id": "hide-unit-in-chain-2",
      "target": "com.bitwig.flt.widget.core.device.htp.MRY",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "chainRow2",
        "descriptor": "(Lcom/bitwig/flt/widget/core/device/gRj;Lcom/bitwig/flt/widget/core/device/htp;Ljsd;)Lcom/bitwig/flt/widget/core/device/gRj;",
        "args": [
          "this",
          "arg1"
        ]
      }
    },
    {
      "id": "hide-unit-in-mixer",
      "target": "com.bitwig.flt.widget.core.device.uMi.MRY",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "row",
        "descriptor": "(Lcom/bitwig/flt/widget/core/device/gRj;Ljsd;)Lcom/bitwig/flt/widget/core/device/gRj;",
        "args": [
          "arg1"
        ]
      }
    }
  ],
  "opens": [
    "SEJ.cfM",
    "com.bitwig.base.geom.SYo.Hnt",
    "com.bitwig.flt.document.core.master.device.zTz.wZs",
    "dve.iG_",
    "dve.kJ_",
    "xJo.DxJ",
    "xJo.mcL",
    "xJo.meo",
    "xJo.sWR",
    "yBZ.lYc"
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    },
    "presets": {
      "kind": "directory",
      "path": "presets"
    }
  },
  "registrations": [
    {
      "id": "inspector",
      "consumer": "inspector-composition-framework",
      "descriptor": "inspector-blocks.properties",
      "jar": "helper.jar"
    },
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ],
  "requires": [
    {
      "id": "inspector-composition-framework",
      "min_version": "0.3.0-dev.2"
    },
    {
      "id": "action-menu-composition-framework",
      "min_version": "0.8.0-dev.1"
    }
  ]
}
