{
  "manifest_version": 2,
  "mod": {
    "id": "missing-device-guard",
    "name": "Missing Device Guard",
    "version": "0.1.0-dev.1",
    "author": "Cimm",
    "description": "Opening a project that uses a native device you don't have installed (e.g. VU Meter) no longer crashes Bitwig: the device shows as \"Device missing\".",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "macos",
    "architecture": "universal"
  },
  "helper": {
    "jar": "helper.jar",
    "class": "com.cimm.missingdeviceguard.MissingDeviceGuard"
  },
  "targets": {
    "com.bitwig.flt.document.core.master.device.AxS.AVR": {
      "kind": "method",
      "owner": "com/bitwig/flt/document/core/master/device/AxS",
      "name": "AVR",
      "descriptor": "()Lcom/bitwig/flt/device/Wkj;"
    },
    "uMW.E1b": {
      "kind": "method",
      "owner": "uMW",
      "name": "E1b",
      "descriptor": "()Lcom/bitwig/flt/device/Wkj;"
    }
  },
  "hooks": [
    {
      "id": "device-identity",
      "target": "com.bitwig.flt.document.core.master.device.AxS.AVR",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "uMW.E1b",
        "occurrence": 1
      },
      "bridge": {
        "method": "identity",
        "descriptor": "(LuMW;)Lcom/bitwig/flt/device/Wkj;",
        "args": []
      }
    }
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  }
}
