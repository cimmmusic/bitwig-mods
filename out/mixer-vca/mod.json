{
  "manifest_version": 2,
  "mod": {
    "id": "mixer-vca",
    "name": "Mixer: VCA",
    "version": "0.1.0-dev.1",
    "author": "Cimm",
    "description": "VCA channels in the mixer: a VCA fader moves its member channels' faders together, with mute and solo for the whole group.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "macos",
    "architecture": "universal"
  },
  "helper": {
    "jar": "helper.jar",
    "class": "com.cimm.mixervca.VcaHooks"
  },
  "targets": {
    "bDJ.cfM": {
      "kind": "method",
      "owner": "bDJ",
      "name": "cfM",
      "descriptor": "(Lcom/bitwig/flt/document/core/iface/RYd;LAQw;)Ldve;"
    },
    "aoH.tp2": {
      "kind": "method",
      "owner": "aoH",
      "name": "tp2",
      "descriptor": "()LaoH;"
    },
    "avb.MRY": {
      "kind": "method",
      "owner": "avb",
      "name": "MRY",
      "descriptor": "(Lcom/bitwig/graphics/SYo;)V"
    },
    "eff.eej": {
      "kind": "method",
      "owner": "eff",
      "name": "eej",
      "descriptor": "()LeeY;"
    },
    "eff.xL": {
      "kind": "method",
      "owner": "eff",
      "name": "xL",
      "descriptor": "()LeeY;"
    }
  },
  "hooks": [
    {
      "id": "fader-channel",
      "target": "bDJ.cfM",
      "transform": "INSERT_AT_ENTRY",
      "bridge": {
        "method": "faderChannel",
        "descriptor": "(Lcom/bitwig/flt/document/core/iface/RYd;)V",
        "args": [
          "arg0"
        ]
      }
    },
    {
      "id": "fader-widget",
      "target": "bDJ.cfM",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKESTATIC",
        "target": "aoH.tp2",
        "occurrence": 1
      },
      "bridge": {
        "method": "faderWidget",
        "descriptor": "()LaoH;",
        "args": []
      }
    },
    {
      "id": "fader-paint",
      "target": "avb.MRY",
      "transform": "INSERT_AT_ENTRY",
      "bridge": {
        "method": "faderPaint",
        "descriptor": "(Lavb;)V",
        "args": [
          "this"
        ]
      }
    },
    {
      "id": "fader-accent-1",
      "target": "avb.MRY",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "eff.eej",
        "occurrence": 1
      },
      "bridge": {
        "method": "accent1",
        "descriptor": "(Leff;)LeeY;",
        "args": []
      }
    },
    {
      "id": "fader-accent-2",
      "target": "avb.MRY",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "eff.eej",
        "occurrence": 1
      },
      "bridge": {
        "method": "accent2",
        "descriptor": "(Leff;)LeeY;",
        "args": []
      }
    },
    {
      "id": "fader-accent-3",
      "target": "avb.MRY",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "eff.xL",
        "occurrence": 1
      },
      "bridge": {
        "method": "accent3",
        "descriptor": "(Leff;)LeeY;",
        "args": []
      }
    }
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ],
  "requires": [
    {
      "id": "action-menu-composition-framework",
      "min_version": "0.8.0-dev.1"
    }
  ]
}
