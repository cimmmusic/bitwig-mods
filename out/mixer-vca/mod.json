{
  "manifest_version": 2,
  "mod": {
    "id": "mixer-vca",
    "name": "Mixer: VCA",
    "version": "0.1.0-dev.1",
    "author": "Cimm",
    "description": "VCA channels in the mixer: a VCA fader moves its member channels' faders together, with mute and solo for the whole group.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "macos",
    "architecture": "universal"
  },
  "helper": {
    "jar": "helper.jar",
    "class": "com.cimm.mixervca.VcaHooks"
  },
  "targets": {
    "bDJ.cfM": {
      "kind": "method",
      "owner": "bDJ",
      "name": "cfM",
      "descriptor": "(Lcom/bitwig/flt/document/core/iface/RYd;LAQw;)Ldve;"
    },
    "duY.Hnt": {
      "kind": "method",
      "owner": "duY",
      "name": "Hnt",
      "descriptor": "(Lejt;)V"
    }
  },
  "hooks": [
    {
      "id": "fader-channel",
      "target": "bDJ.cfM",
      "transform": "INSERT_AT_ENTRY",
      "bridge": {
        "method": "faderChannel",
        "descriptor": "(Lcom/bitwig/flt/document/core/iface/RYd;)V",
        "args": [
          "arg0"
        ]
      }
    },
    {
      "id": "fader-colour",
      "target": "bDJ.cfM",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "duY.Hnt",
        "occurrence": 1
      },
      "bridge": {
        "method": "faderColour",
        "descriptor": "(LduY;Lejt;)V",
        "args": []
      }
    }
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ],
  "requires": [
    {
      "id": "action-menu-composition-framework",
      "min_version": "0.8.0-dev.1"
    }
  ]
}
