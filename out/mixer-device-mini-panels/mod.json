{
  "manifest_version": 2,
  "mod": {
    "id": "mixer-device-mini-panels",
    "name": "Mixer: Device Mini Panels",
    "version": "0.3.0-dev.3",
    "author": "Cimm",
    "description": "Adds graphical mini views under devices in the mixer's Devices section \u2014 EQs, compressors, dynamics, gate, limiter, Over, Saturator, Transient Control, filters, De-Esser, Tool and meters \u2014 with draggable nodes, right-click type menus and live modulation.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "macos",
    "architecture": "universal"
  },
  "helper": {
    "jar": "helper.jar",
    "class": "com.cimm.mixerminipanels.MixerMiniPanels"
  },
  "targets": {
    "com.bitwig.flt.widget.core.device.uMi.MRY": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/device/uMi",
      "name": "MRY",
      "descriptor": "(Ljsd;)Lcom/bitwig/flt/widget/core/device/gRj;"
    },
    "com.bitwig.flt.widget.core.device.g2L.cfM": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/device/g2L",
      "name": "cfM",
      "descriptor": "(Ljsd;ZZ)Lcom/bitwig/flt/widget/core/device/g2L;"
    },
    "dpl.cfM": {
      "kind": "method",
      "owner": "dpl",
      "name": "cfM",
      "descriptor": "(Leoy;)V"
    },
    "dpl.MRY": {
      "kind": "method",
      "owner": "dpl",
      "name": "MRY",
      "descriptor": "(Lepr;)V"
    },
    "dpl.cfM-2": {
      "kind": "method",
      "owner": "dpl",
      "name": "cfM",
      "descriptor": "(Lepr;)V"
    },
    "dpl.MRY-2": {
      "kind": "method",
      "owner": "dpl",
      "name": "MRY",
      "descriptor": "(Leps;)V"
    },
    "dpl.cfM-3": {
      "kind": "method",
      "owner": "dpl",
      "name": "cfM",
      "descriptor": "(Leps;)V"
    },
    "dpl.MRY-3": {
      "kind": "method",
      "owner": "dpl",
      "name": "MRY",
      "descriptor": "(Lepv;)V"
    },
    "dpl.cfM-4": {
      "kind": "method",
      "owner": "dpl",
      "name": "cfM",
      "descriptor": "(Lepv;)V"
    },
    "dpl.cfM-5": {
      "kind": "method",
      "owner": "dpl",
      "name": "cfM",
      "descriptor": "(Leph;)V"
    },
    "dpl.cfM-6": {
      "kind": "method",
      "owner": "dpl",
      "name": "cfM",
      "descriptor": "(Lepz;)V"
    },
    "com.bitwig.flt.widget.core.device.g2L.MRY": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/device/g2L",
      "name": "MRY",
      "descriptor": "(Ljsd;ZZ)V"
    },
    "com.bitwig.flt.widget.core.device.g2L.cfM-2": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/device/g2L",
      "name": "cfM",
      "descriptor": "(LdyC;)V"
    },
    "com.bitwig.flt.widget.core.device.g2L.cfM-3": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/device/g2L",
      "name": "cfM",
      "descriptor": "(Lcom/bitwig/graphics/SYo;)V"
    },
    "com.bitwig.graphics.SYo.MRY": {
      "kind": "method",
      "owner": "com/bitwig/graphics/SYo",
      "name": "MRY",
      "descriptor": "(DDDD)V"
    },
    "auI": {
      "kind": "class",
      "class": "auI"
    },
    "dpl": {
      "kind": "class",
      "class": "dpl"
    },
    "dWb.init": {
      "kind": "method",
      "owner": "dWb",
      "name": "<init>",
      "descriptor": "()V"
    },
    "drX.init": {
      "kind": "method",
      "owner": "drX",
      "name": "<init>",
      "descriptor": "()V"
    },
    "dve.init": {
      "kind": "method",
      "owner": "dve",
      "name": "<init>",
      "descriptor": "()V"
    },
    "dve.MRY": {
      "kind": "method",
      "owner": "dve",
      "name": "MRY",
      "descriptor": "(DDLeoW;Lcom/bitwig/base/geom/DoubleRectangle;)Z"
    },
    "dve.MRY-2": {
      "kind": "method",
      "owner": "dve",
      "name": "MRY",
      "descriptor": "(LeoX;DDLeoW;I)LdrX;"
    },
    "dve.cfM": {
      "kind": "method",
      "owner": "dve",
      "name": "cfM",
      "descriptor": "(DDLeoW;Lcom/bitwig/base/geom/DoubleRectangle;)Z"
    },
    "dve.cfM-2": {
      "kind": "method",
      "owner": "dve",
      "name": "cfM",
      "descriptor": "(LdKW;DDLeoW;)V"
    },
    "dve.cfM-3": {
      "kind": "method",
      "owner": "dve",
      "name": "cfM",
      "descriptor": "(LeoX;DDLeoW;I)LdrX;"
    },
    "dve.iA_": {
      "kind": "method",
      "owner": "dve",
      "name": "iA_",
      "descriptor": "()V"
    },
    "dve.iz_": {
      "kind": "method",
      "owner": "dve",
      "name": "iz_",
      "descriptor": "()V"
    },
    "dve.kJ_": {
      "kind": "method",
      "owner": "dve",
      "name": "kJ_",
      "descriptor": "()V"
    }
  },
  "hooks": [
    {
      "id": "no-bitwig-overview",
      "target": "com.bitwig.flt.widget.core.device.uMi.MRY",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKESTATIC",
        "target": "com.bitwig.flt.widget.core.device.g2L.cfM",
        "occurrence": 1
      },
      "bridge": {
        "method": "buildRow",
        "descriptor": "(Ljsd;ZZ)Lcom/bitwig/flt/widget/core/device/g2L;",
        "args": []
      }
    },
    {
      "id": "scroll-epr",
      "target": "dpl.cfM",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "dpl.MRY",
        "occurrence": 1
      },
      "bridge": {
        "method": "scroll_epr",
        "descriptor": "(Ldpl;Lepr;)V",
        "args": []
      }
    },
    {
      "id": "scroll-epr-queued",
      "target": "dpl.cfM",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "dpl.cfM-2",
        "occurrence": 1
      },
      "bridge": {
        "method": "scroll_epr_queued",
        "descriptor": "(Ldpl;Lepr;)V",
        "args": []
      }
    },
    {
      "id": "scroll-eps",
      "target": "dpl.cfM",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "dpl.MRY-2",
        "occurrence": 1
      },
      "bridge": {
        "method": "scroll_eps",
        "descriptor": "(Ldpl;Leps;)V",
        "args": []
      }
    },
    {
      "id": "scroll-eps-queued",
      "target": "dpl.cfM",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "dpl.cfM-3",
        "occurrence": 1
      },
      "bridge": {
        "method": "scroll_eps_queued",
        "descriptor": "(Ldpl;Leps;)V",
        "args": []
      }
    },
    {
      "id": "scroll-epv",
      "target": "dpl.cfM",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "dpl.MRY-3",
        "occurrence": 1
      },
      "bridge": {
        "method": "scroll_epv",
        "descriptor": "(Ldpl;Lepv;)V",
        "args": []
      }
    },
    {
      "id": "scroll-epv-queued",
      "target": "dpl.cfM",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "dpl.cfM-4",
        "occurrence": 1
      },
      "bridge": {
        "method": "scroll_epv_queued",
        "descriptor": "(Ldpl;Lepv;)V",
        "args": []
      }
    },
    {
      "id": "scroll-eph",
      "target": "dpl.cfM",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "dpl.cfM-5",
        "occurrence": 1
      },
      "bridge": {
        "method": "scroll_eph",
        "descriptor": "(Ldpl;Leph;)V",
        "args": []
      }
    },
    {
      "id": "scroll-epz",
      "target": "dpl.cfM",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "dpl.cfM-6",
        "occurrence": 1
      },
      "bridge": {
        "method": "scroll_epz",
        "descriptor": "(Ldpl;Lepz;)V",
        "args": []
      }
    },
    {
      "id": "add-mini-panel",
      "target": "com.bitwig.flt.widget.core.device.g2L.MRY",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "com.bitwig.flt.widget.core.device.g2L.cfM-2",
        "occurrence": 1
      },
      "bridge": {
        "method": "setRowContent",
        "descriptor": "(Lcom/bitwig/flt/widget/core/device/g2L;LdyC;)V",
        "args": []
      }
    },
    {
      "id": "row-outline-start",
      "target": "com.bitwig.flt.widget.core.device.g2L.cfM-3",
      "transform": "INSERT_AT_ENTRY",
      "bridge": {
        "method": "rowOutlineStart",
        "descriptor": "(Lcom/bitwig/flt/widget/core/device/g2L;)V",
        "args": [
          "this"
        ]
      }
    },
    {
      "id": "row-outline",
      "target": "com.bitwig.flt.widget.core.device.g2L.cfM-3",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEINTERFACE",
        "target": "com.bitwig.graphics.SYo.MRY",
        "occurrence": 1
      },
      "bridge": {
        "method": "rowOutline",
        "descriptor": "(Lcom/bitwig/graphics/SYo;DDDD)V",
        "args": []
      }
    }
  ],
  "opens": [
    "auI",
    "dWb.init",
    "dpl",
    "dpl.MRY",
    "dpl.MRY-2",
    "dpl.MRY-3",
    "dpl.cfM-2",
    "dpl.cfM-3",
    "dpl.cfM-4",
    "dpl.cfM-5",
    "dpl.cfM-6",
    "drX.init",
    "dve.MRY",
    "dve.MRY-2",
    "dve.cfM",
    "dve.cfM-2",
    "dve.cfM-3",
    "dve.iA_",
    "dve.init",
    "dve.iz_",
    "dve.kJ_"
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ],
  "requires": [
    {
      "id": "action-menu-composition-framework",
      "min_version": "0.8.0-dev.1"
    }
  ]
}
