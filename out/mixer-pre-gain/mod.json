{
  "manifest_version": 2,
  "mod": {
    "id": "mixer-pre-gain",
    "name": "Mixer: Pre Gain",
    "version": "0.1.0-dev.1",
    "author": "Cimm",
    "description": "A gain knob at the top of every mixer channel, like an input gain. It sets a hidden Tool placed right after the instrument (or first on audio tracks), so it trims the channel before its effects.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "macos",
    "architecture": "universal"
  },
  "helper": {
    "jar": "helper.jar",
    "class": "com.cimm.mixerpregain.PreGainHooks"
  },
  "targets": {
    "bwC.cfM": {
      "kind": "method",
      "owner": "bwC",
      "name": "cfM",
      "descriptor": "(Lcom/bitwig/flt/document/core/iface/RYd;Z)Ldve;"
    },
    "byu.cfM": {
      "kind": "method",
      "owner": "byu",
      "name": "cfM",
      "descriptor": "(Lcom/bitwig/flt/document/core/iface/RYd;Z)Ldve;"
    },
    "com.bitwig.flt.widget.core.device.THR.UNj": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/device/THR",
      "name": "UNj",
      "descriptor": "(Ljsd;)V"
    },
    "com.bitwig.flt.widget.core.device.THR.cfM": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/device/THR",
      "name": "cfM",
      "descriptor": "(Ljsd;)Lcom/bitwig/flt/widget/core/device/gRj;"
    },
    "com.bitwig.flt.widget.core.device.THR.FzB": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/device/THR",
      "name": "FzB",
      "descriptor": "(Ljsd;)V"
    },
    "com.bitwig.flt.widget.core.device.uMi.MRY": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/device/uMi",
      "name": "MRY",
      "descriptor": "(Ljsd;)Lcom/bitwig/flt/widget/core/device/gRj;"
    },
    "TZU.FzB": {
      "kind": "field",
      "owner": "TZU",
      "name": "FzB",
      "descriptor": "Ldep;"
    },
    "drX.init": {
      "kind": "method",
      "owner": "drX",
      "name": "<init>",
      "descriptor": "()V"
    },
    "dve.init": {
      "kind": "method",
      "owner": "dve",
      "name": "<init>",
      "descriptor": "()V"
    },
    "dve.MRY": {
      "kind": "method",
      "owner": "dve",
      "name": "MRY",
      "descriptor": "(LeoX;DDLeoW;I)LdrX;"
    },
    "dve.cfM": {
      "kind": "method",
      "owner": "dve",
      "name": "cfM",
      "descriptor": "(LeoX;DDLeoW;I)LdrX;"
    }
  },
  "hooks": [
    {
      "id": "section-track",
      "target": "bwC.cfM",
      "transform": "INSERT_AT_ENTRY",
      "bridge": {
        "method": "sectionTrack",
        "descriptor": "(Lcom/bitwig/flt/document/core/iface/RYd;)V",
        "args": [
          "arg1"
        ]
      }
    },
    {
      "id": "section",
      "target": "bwC.cfM",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "section",
        "descriptor": "(Ldve;)Ldve;",
        "args": []
      }
    },
    {
      "id": "section-track-2",
      "target": "byu.cfM",
      "transform": "INSERT_AT_ENTRY",
      "bridge": {
        "method": "sectionTrack2",
        "descriptor": "(Lcom/bitwig/flt/document/core/iface/RYd;)V",
        "args": [
          "arg1"
        ]
      }
    },
    {
      "id": "section-2",
      "target": "byu.cfM",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "section2",
        "descriptor": "(Ldve;)Ldve;",
        "args": []
      }
    },
    {
      "id": "panel-device",
      "target": "com.bitwig.flt.widget.core.device.THR.UNj",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "com.bitwig.flt.widget.core.device.THR.cfM",
        "occurrence": 1
      },
      "bridge": {
        "method": "panelDevice",
        "descriptor": "(Lcom/bitwig/flt/widget/core/device/THR;Ljsd;)Lcom/bitwig/flt/widget/core/device/gRj;",
        "args": []
      }
    },
    {
      "id": "panel-device-2",
      "target": "com.bitwig.flt.widget.core.device.THR.FzB",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "com.bitwig.flt.widget.core.device.THR.cfM",
        "occurrence": 1
      },
      "bridge": {
        "method": "panelDevice2",
        "descriptor": "(Lcom/bitwig/flt/widget/core/device/THR;Ljsd;)Lcom/bitwig/flt/widget/core/device/gRj;",
        "args": []
      }
    },
    {
      "id": "row-device",
      "target": "com.bitwig.flt.widget.core.device.uMi.MRY",
      "transform": "INSERT_AT_ENTRY",
      "bridge": {
        "method": "rowDevice",
        "descriptor": "(Ljsd;)V",
        "args": [
          "arg1"
        ]
      }
    },
    {
      "id": "row",
      "target": "com.bitwig.flt.widget.core.device.uMi.MRY",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "row",
        "descriptor": "(Lcom/bitwig/flt/widget/core/device/gRj;)Lcom/bitwig/flt/widget/core/device/gRj;",
        "args": []
      }
    }
  ],
  "opens": [
    "TZU.FzB",
    "drX.init",
    "dve.MRY",
    "dve.cfM",
    "dve.init"
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  }
}
