    {
      "id": "pill-outline-q",
      "target": "dyQ.MRY",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEINTERFACE",
        "target": "com.bitwig.graphics.SYo.cfM-2",
        "occurrence": 1
