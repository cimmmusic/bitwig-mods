    },
    "com.bitwig.graphics.SYo.cfM-2": {
      "kind": "method",
      "owner": "com/bitwig/graphics/SYo",
      "name": "cfM",
      "descriptor": "(DDDDDLiok;Liok;Ljava/util/EnumSet;)V"
    },
    "com.bitwig.graphics.SYo.cfM-3": {
      "kind": "method",
      "owner": "com/bitwig/graphics/SYo",
      "name": "cfM",
      "descriptor": "(DDDDDLjava/util/EnumSet;D)V"
    },
    "dyO.MRY-2": {
      "kind": "method",
      "owner": "dyO",
      "name": "MRY",
      "descriptor": "(Lcom/bitwig/graphics/SYo;DDDDLjava/util/EnumSet;)V"
    }
  },
  "hooks": [
    {
      "id": "pill-fill",
      "target": "dyK.cfM",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKEINTERFACE",
        "target": "com.bitwig.graphics.SYo.cfM",
        "occurrence": 1
      },
      "bridge": {
        "method": "fill",
        "descriptor": "(Lcom/bitwig/graphics/SYo;DDDDDLjava/util/EnumSet;)V",
        "args": []
      }
    },
    {
      "id": "pill-path",
      "target": "dyK.MRY",
