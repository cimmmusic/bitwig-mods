      "match": {
        "opcode": "INVOKEINTERFACE",
        "target": "com.bitwig.graphics.SYo.MRY",
        "occurrence": 1
      },
      "bridge": {
        "method": "path",
        "descriptor": "(Lcom/bitwig/graphics/SYo;DDDDDLjava/util/EnumSet;)V",
        "args": []
      }
    },
    {
      "id": "pill-frame",
