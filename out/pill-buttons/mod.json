{
  "manifest_version": 2,
  "mod": {
    "id": "pill-buttons",
    "name": "Interface: Pill Buttons",
    "version": "0.3.0-dev.1",
    "author": "Cimm",
    "description": "Bitwig's buttons, fields and small frames drawn fully rounded (pill-shaped), for a minimal, futuristic look. Pairs with the Minimal theme.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "macos",
    "architecture": "universal"
  },
  "helper": {
    "jar": "helper.jar",
    "class": "com.cimm.pillbuttons.Pill"
  },
  "targets": {
    "dyK.cfM": {
      "kind": "method",
      "owner": "dyK",
      "name": "cfM",
      "descriptor": "(Lcom/bitwig/graphics/SYo;DDDDLjava/util/EnumSet;)V"
    },
    "com.bitwig.graphics.SYo.cfM": {
      "kind": "method",
      "owner": "com/bitwig/graphics/SYo",
      "name": "cfM",
      "descriptor": "(DDDDDLjava/util/EnumSet;)V"
    },
    "dyK.MRY": {
      "kind": "method",
      "owner": "dyK",
      "name": "MRY",
      "descriptor": "(Lcom/bitwig/graphics/SYo;DDDDLjava/util/EnumSet;)V"
    },
    "com.bitwig.graphics.SYo.MRY": {
      "kind": "method",
      "owner": "com/bitwig/graphics/SYo",
      "name": "MRY",
      "descriptor": "(DDDDDLjava/util/EnumSet;)V"
    },
    "dyK.cfM-2": {
      "kind": "method",
      "owner": "dyK",
      "name": "cfM",
      "descriptor": "(Lcom/bitwig/graphics/SYo;Ldve;DDDDLjava/util/EnumSet;)V"
    },
    "com.bitwig.graphics.SYo.Hnt": {
      "kind": "method",
      "owner": "com/bitwig/graphics/SYo",
      "name": "Hnt",
      "descriptor": "(DDDDDLjava/util/EnumSet;)V"
    },
    "aCf.cfM": {
      "kind": "method",
      "owner": "aCf",
      "name": "cfM",
      "descriptor": "(LaBF;)Ldve;"
    },
    "dyO.MRY": {
      "kind": "method",
      "owner": "dyO",
      "name": "MRY",
      "descriptor": "(Lcom/bitwig/graphics/SYo;Ldve;DDDDLjava/util/EnumSet;)V"
    },
    "dyQ.MRY": {
      "kind": "method",
      "owner": "dyQ",
      "name": "MRY",
      "descriptor": "(Lcom/bitwig/graphics/SYo;Ldve;DDDDLjava/util/EnumSet;)V"
