{
  "manifest_version": 2,
  "mod": {
    "id": "highlight-colour",
    "name": "Interface: Highlight & Background",
    "version": "0.3.0-dev.2",
    "author": "Cimm",
    "description": "Choose Bitwig's highlight colour, tint the background (hue, saturation, luminance, contrast) and keep text readable: light backgrounds get dark text, dark ones light text, and text on coloured items is black or white, whichever contrasts more. Works with any theme.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "macos",
    "architecture": "universal"
  },
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    },
    "colours_in_use": {
      "kind": "file",
      "path": "colours-in-use.tsv",
      "persistence": "created"
    }
  },
  "registrations": [
    {
      "id": "preferences",
      "consumer": "preferences-composition-framework",
      "descriptor": "preferences.properties",
      "jar": "helper.jar"
    }
  ],
  "requires": [
    {
      "id": "preferences-composition-framework",
      "min_version": "1.0.0"
    }
  ]
}
