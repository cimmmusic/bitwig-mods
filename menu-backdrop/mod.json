{
  "manifest_version": 2,
  "mod": {
    "id": "menu-backdrop",
    "name": "Interface: Menu Backdrop",
    "version": "0.2.0-dev.2",
    "author": "Cimm",
    "description": "While a menu or popup is open, the window behind it softly blurs (or dims) with a short fade, so the menu stands out. Choose Blur, Dim or Off.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "macos",
    "architecture": "universal"
  },
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "registrations": [
    {
      "id": "preferences",
      "consumer": "preferences-composition-framework",
      "descriptor": "preferences.properties",
      "jar": "helper.jar"
    }
  ],
  "requires": [
    {
      "id": "preferences-composition-framework",
      "min_version": "1.0.0"
    }
  ]
}
