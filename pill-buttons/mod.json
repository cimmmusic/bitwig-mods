{
  "manifest_version": 2,
  "mod": {
    "id": "pill-buttons",
    "name": "Interface: Pill Buttons",
    "version": "0.4.0-dev.1",
    "author": "Cimm",
    "description": "Bitwig's buttons, fields and small frames drawn fully rounded (pill-shaped), for a minimal, futuristic look. Pairs with the Minimal theme.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "macos",
    "architecture": "universal"
  },
  "resources": {
    "readme": { "kind": "file", "path": "README.md", "media_type": "text/markdown" }
  },
  "registrations": [
    {
      "id": "preferences",
      "consumer": "preferences-composition-framework",
      "descriptor": "preferences.properties",
      "jar": "helper.jar"
    }
  ],
  "requires": [
    { "id": "preferences-composition-framework", "min_version": "1.0.0" }
  ]
}
