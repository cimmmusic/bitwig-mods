// Minimal 0.2: true black, flat, hairline outlines, white text and icons, one signal-orange accent.
// Buttons have no background (transparent), no shadows, no emboss, no gradients.
Gradient: false

// ---- surfaces: neutral near-black, a step per level ----
Window background: #000000
Grey 0: #000000
Grey 1: #050505
Grey 2: #090909
Grey 3: #0D0D0D
Grey 4: #111111
Grey 5: #161616
Grey 6: #1C1C1C
Brighter: #262626
Popup insert: #1C1C1C
Selected Dashboard Tree: #111111
Dark Panel Sub-frame Fill: #050505
Dark Panel Sub-frame Stroke: #1A1A1A
Panel Stroke (focused): #2A2A2A
Light Separator Line: #1A1A1A
Shadow: #00000000

// ---- buttons: no backgrounds, no outlines; selected/pressed a soft grey ----
Button background: #00000000
Button stroke: #2E2E2E
Pressed button background: #FFFFFF12
View button background: #00000000
Pressed view button background: #141414
OK Button background: #1C1C1C
Checkbox background: #1C1C1C
Button in tree background: #111111
Icon Frame: #00000000
Abstract Button Stroke: #2E2E2E
Abstract Button Unselected Background: #00000000
Abstract Button Selected Background: #FFFFFF14
Abstract Button Pressed Background: #FFFFFF0C
Inverted Selected Borderless Button background: #262626
Selected borderless button background: #FFFFFF10
Pressed borderless button background: #FFFFFF18
Timeline edit tool chooser background: #00000000
Close button mouse over background: #FFFFFF14
Close button pressed background: #FFFFFF22

// ---- icons ----
Normal Toggle Icon: #7A7A7A
Mouse Over Toggle Icon: #F5F5F5
Pressed Toggle Icon: #D6D6D6
Active Toggle Icon (Playing): #FF5F1F
Normal Inverted Toggle Icon: #00000044
Mouse Over Inverted Toggle Icon: #00000088
Active Inverted Toggle Icon (Playing): #F5F5F5
Pressed Inverted Toggle Icon: #000000
Menu Icon: #BDBDBD

// ---- text ----
Default text: #F5F5F5
Light Text: #F5F5F5
Lighter Text: #FFFFFF
Medium Light Text: #F5F5F5C8
Subtle Light Text: #F5F5F58C
Subtler Light Text: #F5F5F552
Dark Text: #F5F5F5
Subtle Dark Text: #4A4A4A
Link Text: #F5F5F5
Error Text: #FF453AC8

// ---- accent ----
Accent (default): #FF5F1F
Implicit On (subtle): #8C3A14
Accent (hitech): #F5F5F5
Led On: #FF5F1F
Led Off: #1C1C1C
Drop Indicator: #FF5F1F
Beat Marker Color: #FF5F1F
Analyzed Beat Color: #8A8A8A
Device Locked Overlay: #FF5F1F33
Comp fill: #FF5F1F33
Number field bar background: #1C1C1C

// ---- states ----
Record button color: #FF453A
Record text color: #FF453A
Monitoring buttons color: #E8C547
Activation Green: #5BD07A
Activation Yellow: #E8C547
Activation Red: #FF453A
Warning: #FF453A
Notification Background: #0A0A0A
Notification Normal: #FF5F1F
Notification Error: #FF453A
Popup Notification Background: #000000CC
Popup overlay background color: #080808CC
Progress bar: #F5F5F5
Progress background: #1C1C1C
Hitcount background: #1C1C1C
Hitcount text color: #F5F5F5
User Automation Override Color: #5BD07A
Automation Color: #BDBDBD

// ---- menus, fields, tooltips ----
Menu background: #0A0A0A
Menu stroke: #222222
Menu text: #F5F5F5
Menu description text: #7A7A7A
Menu separator: #161616
Field background: #0A0A0A
Slider background: #161616
Automation Chooser Background: #0A0A0A
Tooltip Background: #0A0A0A
Tooltip Stroke: #262626
Light Tooltip Background: #EDEDED

// ---- lists and trees ----
List Item Background: #050505
List Separator: #121212
Tree Item Background: #050505
Tree Separator: #00000000
Dark tree background (selected): #1C1C1C
Dark tree background (standby selected): #111111
Dark tree separator: #121212
Dark tree text: #F5F5F5
Dark tree text (selected): #FFFFFF
Dark tree hover background change: #FFFFFF08
White Selection: #F5F5F5
White Selection (standby): #F5F5F566

// ---- scrollbars ----
Scrollbar: #222222
Scrollbar background: #00000000
Modern Scrollbar Handle (active): #2E2E2E
Modern Scrollbar Handle (inactive): #2E2E2E88
Modern Scrollbar Background (active): #FFFFFF0A
Modern Dark Scrollbar Handle (active): #000000FF
Modern Dark Scrollbar Handle (inactive): #00000088

// ---- knobs: flat body, white line and value, no emboss ----
Knob Body: #111111
Knob Body Lighter: #111111
Knob Body Lightest: #2A2A2A
Knob Body Darkest: #0A0A0A
Knob Stroke: #262626
Knob Line: #F5F5F5
Knob Line Dark: #080808
Knob Emboss Highlight: #00000000
Knob Emboss Shadow: #00000000
Knob Value Background: #1C1C1C
Knob Value Background (dark): #0D0D0D
Knob Value Color: #F5F5F5

// ---- meters ----
Meter Normal: #F5F5F5
Meter Yellow: #FFB020
Meter Red: #FF453A
Meter Clipping: #FF453A
Meter Gain Reduction: #8A8A8A
Meter Hitech: #F5F5F5
Meter Hitech Background: #F5F5F51E
Meter Muted: #2A2A2A
Muted by Audition: #080808B2

// ---- displays, devices, grid ----
Display Background: #000000
Display Stroke: #1C1C1C
Grey Display Background: #00000080
Display Background (error): #2A1212
Display Waveform: #F5F5F5
Display Start/End Markers: #FF5F1F
Display Loop Markers: #F5F5F5
Device Header: #0A0A0A
Device Header (selected): #161616
Device Tint Future: #00000000
Device Tint Retro: #00000000
Device Tint Military: #00000000
The Grid (background): #000000
The Grid (stroke): #121212
Grid Line (Primary): #000000FF
Grid Line (Secondary): #00000040
Audio Event Background: #0D0D0D
Audio Event Boundary: #00000080
Audio Event Waveform: #D9D9D9
Dark offset for automation/channel bar: #00000033
Light offset for automation/channel bar: #FFFFFF1A

