// Minimal: near-black, flat, hairlines, white text and icons, one orange accent.
// Buttons have no background (transparent), no shadows, no emboss, no gradients.
Gradient: false

// ---- surfaces: neutral near-black, a step per level ----
Window background: #080808
Grey 0: #080808
Grey 1: #0D0D0D
Grey 2: #121212
Grey 3: #171717
Grey 4: #1E1E1E
Grey 5: #262626
Grey 6: #303030
Brighter: #3A3A3A
Popup insert: #262626
Selected Dashboard Tree: #1A1A1A
Dark Panel Sub-frame Fill: #0D0D0D
Dark Panel Sub-frame Stroke: #1E1E1E
Panel Stroke (focused): #2E2E2E
Light Separator Line: #262626
Shadow: #00000000

// ---- buttons: no backgrounds, no outlines; selected/pressed a soft grey ----
Button background: #00000000
Button stroke: #00000000
Pressed button background: #FFFFFF14
View button background: #00000000
Pressed view button background: #1E1E1E
OK Button background: #262626
Checkbox background: #262626
Button in tree background: #1A1A1A
Icon Frame: #00000000
Abstract Button Stroke: #00000000
Abstract Button Unselected Background: #00000000
Abstract Button Selected Background: #262626
Abstract Button Pressed Background: #1E1E1E
Inverted Selected Borderless Button background: #303030
Selected borderless button background: #1E1E1E
Pressed borderless button background: #262626
Timeline edit tool chooser background: #00000000
Close button mouse over background: #FFFFFF14
Close button pressed background: #FFFFFF22

// ---- icons ----
Normal Toggle Icon: #8A8A8A
Mouse Over Toggle Icon: #F5F5F5
Pressed Toggle Icon: #CFCFCF
Active Toggle Icon (Playing): #FF7A1A
Normal Inverted Toggle Icon: #00000044
Mouse Over Inverted Toggle Icon: #00000088
Active Inverted Toggle Icon (Playing): #F5F5F5
Pressed Inverted Toggle Icon: #000000
Menu Icon: #CFCFCF

// ---- text ----
Default text: #F5F5F5
Light Text: #F5F5F5
Lighter Text: #FFFFFF
Medium Light Text: #F5F5F5CC
Subtle Light Text: #F5F5F599
Subtler Light Text: #F5F5F55C
Dark Text: #F5F5F5
Subtle Dark Text: #5C5C5C
Link Text: #F5F5F5
Error Text: #FF453AC8

// ---- accent ----
Accent (default): #FF7A1A
Implicit On (subtle): #B35A17
Accent (hitech): #F5F5F5
Led On: #FF7A1A
Led Off: #262626
Drop Indicator: #FF7A1A
Beat Marker Color: #FF7A1A
Analyzed Beat Color: #8A8A8A
Device Locked Overlay: #FF7A1A33
Comp fill: #FF7A1A33
Number field bar background: #262626

// ---- states ----
Record button color: #FF453A
Record text color: #FF453A
Monitoring buttons color: #E8C547
Activation Green: #5BD07A
Activation Yellow: #E8C547
Activation Red: #FF453A
Warning: #FF453A
Notification Background: #141414
Notification Normal: #FF7A1A
Notification Error: #FF453A
Popup Notification Background: #000000CC
Popup overlay background color: #080808CC
Progress bar: #F5F5F5
Progress background: #262626
Hitcount background: #262626
Hitcount text color: #F5F5F5
User Automation Override Color: #5BD07A
Automation Color: #BDBDBD

// ---- menus, fields, tooltips ----
Menu background: #0F0F0F
Menu stroke: #262626
Menu text: #F5F5F5
Menu description text: #7A7A7A
Menu separator: #1F1F1F
Field background: #121212
Slider background: #1E1E1E
Automation Chooser Background: #141414
Tooltip Background: #141414
Tooltip Stroke: #2A2A2A
Light Tooltip Background: #EDEDED

// ---- lists and trees ----
List Item Background: #0D0D0D
List Separator: #1A1A1A
Tree Item Background: #0D0D0D
Tree Separator: #00000000
Dark tree background (selected): #262626
Dark tree background (standby selected): #1A1A1A
Dark tree separator: #1A1A1A
Dark tree text: #F5F5F5
Dark tree text (selected): #FFFFFF
Dark tree hover background change: #FFFFFF08
White Selection: #F5F5F5
White Selection (standby): #F5F5F566

// ---- scrollbars ----
Scrollbar: #2A2A2A
Scrollbar background: #00000000
Modern Scrollbar Handle (active): #3A3A3A
Modern Scrollbar Handle (inactive): #3A3A3A88
Modern Scrollbar Background (active): #FFFFFF0A
Modern Dark Scrollbar Handle (active): #000000FF
Modern Dark Scrollbar Handle (inactive): #00000088

// ---- knobs: flat body, white line and value, no emboss ----
Knob Body: #1C1C1C
Knob Body Lighter: #1C1C1C
Knob Body Lightest: #3A3A3A
Knob Body Darkest: #141414
Knob Stroke: #262626
Knob Line: #F5F5F5
Knob Line Dark: #080808
Knob Emboss Highlight: #00000000
Knob Emboss Shadow: #00000000
Knob Value Background: #262626
Knob Value Background (dark): #141414
Knob Value Color: #F5F5F5

// ---- meters ----
Meter Normal: #F5F5F5
Meter Yellow: #FFB020
Meter Red: #FF453A
Meter Clipping: #FF453A
Meter Gain Reduction: #8A8A8A
Meter Hitech: #F5F5F5
Meter Hitech Background: #F5F5F51E
Meter Muted: #3A3A3A
Muted by Audition: #080808B2

// ---- displays, devices, grid ----
Display Background: #0D0D0D
Display Stroke: #232323
Grey Display Background: #0D0D0D80
Display Background (error): #2A1212
Display Waveform: #F5F5F5
Display Start/End Markers: #FF7A1A
Display Loop Markers: #F5F5F5
Device Header: #111111
Device Header (selected): #1E1E1E
Device Tint Future: #00000000
Device Tint Retro: #00000000
Device Tint Military: #00000000
The Grid (background): #0A0A0A
The Grid (stroke): #1A1A1A
Grid Line (Primary): #000000FF
Grid Line (Secondary): #00000040
Audio Event Background: #141414
Audio Event Boundary: #00000080
Audio Event Waveform: #D9D9D9
Dark offset for automation/channel bar: #00000033
Light offset for automation/channel bar: #FFFFFF1A

// ---- timeline ----
Header Loop Region Background: #00000022
Header Time Selection Across All Lanes Fill: #262626CC
Header Time Selection Across All Lanes Stroke: #F5F5F5
Header Time Selection Cursor Stroke: #F5F5F5
Header Time Selection Fill: #1E1E1ECC
Header Time Selection Standby Cursor Stroke: #BDBDBD
Header Time Selection Standby Fill: #FFFFFF06
Header Time Selection Standby Stroke: #BDBDBD
Header Time Selection Stroke: #F5F5F5
Loop Region Background: #FFFFFF14
Time Selection Across All Lanes Fill: #FFFFFF22
Time Selection Across All Lanes Stroke: #F5F5F5
Time Selection Cursor Stroke: #F5F5F5
