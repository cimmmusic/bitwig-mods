{
  "manifest_version": 3,
  "package_type": "component",
  "component": {
    "id": "default",
    "name": "Default (Bitwig)",
    "version": "1.0.0",
    "author": "Cimm",
    "description": "Bitwig's own look: no colours changed, gradients and icons as Bitwig ships them.",
