{
  "manifest_version": 2,
  "mod": {
    "id": "pin-channels",
    "name": "Pin Channels",
    "version": "0.1.0-dev.1",
    "author": "Cimm",
    "description": "Pin channels (e.g. VCAs) so they stay in view: a fixed bar at the top of the arranger and a fixed area at the left of the mixer, with mute, solo and volume.",
    "documentation": "readme"
  },
  "built_against": { "bitwig_version": "6.1.4", "platform": "macos", "architecture": "universal" },
  "resources": { "readme": { "kind": "file", "path": "README.md", "media_type": "text/markdown" } },
  "registrations": [
    { "id": "actions", "consumer": "action-menu-composition-framework", "descriptor": "actions.properties", "jar": "helper.jar" }
  ],
  "requires": [ { "id": "action-menu-composition-framework", "min_version": "0.8.0-dev.1" } ]
}
